; title.ini - which background video the title screen shows (Tsukihime, both editions).
; Copy it as title.ini next to the exe, or into the data root of each edition (data\tsuki and data\tsuki_global),
; or point NX_TITLE_INI at any file. NX_TITLE_BG=<value> overrides "video" without editing the file.
; Comments with ; or #. A mistake is written to the log with its line number and that line is skipped.
; Changes are read when the game starts. Check the log: "title: titlebg1.mp4 -> titlebg3.mp4".
;
; The game normally picks titlebg1..4 by itself from the routes you have cleared. Here you replace that choice.
; The music of the title screen is a separate track (not the audio of the mp4): videos 1, 2 and 3 share one track
; (stream\MOON01_BGM02.opus) and video 4 has another (stream\MOON01_BGM59.opus). By default the music goes with the video.

[title]
; auto    the game's own choice (default; same as having no title.ini)
; 1 to 4  always that video (movie\titlebg<N>.mp4)
; random  a different video each time the title screen opens (never the same twice in a row)
; cycle   the videos of "pool" in order, one per time the title screen opens
video = auto

; Only for random and cycle: which videos they use, separated by commas (default 1, 2, 3, 4).
; pool = 1, 2, 3, 4

; Music of the title screen.
; follow  the music of the video that is shown (default; nothing changes while video = auto)
; game    the game's own music, whatever the video is
; 1 to 4  always the music of that video (works with video = auto too: e.g. the game's video with the music of the 4th)
; music = follow
;
; The music only changes on the title screen (the story plays the same tracks and is never touched), including when you
; come back to it from the game.

; F5 / F6 on the title screen: previous / next video of "pool" while the title screen is up, with a fade: the picture (and
; the music, if the track changes) fades out, the other video starts at black and both fade in.
; on (default) / off
; hotkeys = on
;
; A left click on the game's logo (the kanji or TSUKIHIME) in the title menu does what F6 does. It only works
; while the menu options are on screen: on "press any button" the click starts the game as always. AP_TITLE_CLICK
; Like F5 / F6, it only goes through the videos your save has unlocked (see unlock below).
; on (default) / off
; click = on
;
; Length of each half of that fade in milliseconds (default 500; 0 = no fade, the change is immediate).
; fade = 500
;
; How long the fade in waits after the video is swapped, for the first frames of the new video to reach the screen
; (milliseconds, default 450). Raise it if you still see the old video after the fade in.
; swap_delay = 450
;
; Where the loop of MOON01_BGM02.opus starts, in seconds, for the music chosen with F5 / F6 (the game's own value is not
; known; 0 = it loops from the start). MOON01_BGM59.opus loops from 17.84 s, the value the game uses.
; loop_bgm02 = 0

; Only the videos (and music) your save has unlocked. The game picks the title video from your progress, so the highest
; titlebg number it asks for is what is unlocked (1 on a new save). video, pool, music, F5 / F6 and the click on
; the logo stay within it (AP_TITLE_CLICK).
; on (default) / off (all four)
; unlock = on
