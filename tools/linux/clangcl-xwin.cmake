# clangcl-xwin.cmake - CMake toolchain to build the Windows exe FROM LINUX (cross build).
#
# clang-cl + lld-link + llvm-lib + llvm-rc + llvm-mt (official LLVM, GitHub tarball) against the MSVC CRT/STL and the
# Windows SDK downloaded by xwin (splat with --use-winsysroot-style --preserve-ms-arch-notation). Nothing of Windows is
# versioned: each PC downloads its copy with xwin and accepts the Microsoft license.
#
# Used in two ways:
#   - vcpkg (x64-windows overlay triplet on Linux): a wrapper generated by the script first includes
#     <vcpkg>/scripts/toolchains/windows.cmake (as on Windows) and then this file, with NX_XWIN and NX_LLVM fixed.
#   - The game build (step 9 of recomp): vcpkg.cmake + -DVCPKG_CHAINLOAD_TOOLCHAIN_FILE=<this file>
#     -DNX_XWIN=<xwin folder> -DNX_LLVM=<LLVM bin>.
# Not used on Windows: there the build keeps using clang-cl from the PATH and the VS environment, as always.
#
# NX_XWIN: output folder of "xwin splat" (contains "VC" and "Windows Kits").
# NX_LLVM: bin folder of the LLVM with clang-cl (by default, the one in the PATH).
# Both can come as a CMake variable (-D, they stay in the cache) or from the environment.

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_SYSTEM_VERSION 10.0)
# The CMake checks (try_compile: "Check for working C compiler", ABI, check_*) link in Debug by default
# (/MDd -> msvcrtd.lib). xwin does not download the Debug CRT libraries (they are not redistributable) and here
# everything is Release (VCPKG_BUILD_TYPE release and the game): the checks too.
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)

foreach(_nx_var NX_XWIN NX_LLVM)
    if(NOT ${_nx_var} AND DEFINED ENV{${_nx_var}})
        set(${_nx_var} "$ENV{${_nx_var}}")
    endif()
endforeach()
# try_compile reads this file again in a separate project: the two paths are passed to it.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES NX_XWIN NX_LLVM NX_AR_GNU)

if(NOT NX_XWIN OR NOT EXISTS "${NX_XWIN}/VC/Tools/MSVC")
    message(FATAL_ERROR "clangcl-xwin.cmake: NX_XWIN='${NX_XWIN}' is not an output of 'xwin splat --use-winsysroot-style' (VC/Tools/MSVC is missing)")
endif()

if(NX_LLVM)
    set(_nx_hint HINTS "${NX_LLVM}" NO_DEFAULT_PATH)
else()
    set(_nx_hint "")
endif()
find_program(NX_CLANG_CL clang-cl ${_nx_hint} REQUIRED)
get_filename_component(_nx_bin "${NX_CLANG_CL}" DIRECTORY)
foreach(_nx_tool lld-link llvm-lib llvm-ar llvm-rc llvm-mt)
    if(NOT EXISTS "${_nx_bin}/${_nx_tool}")
        message(FATAL_ERROR "clangcl-xwin.cmake: ${_nx_bin}/${_nx_tool} is missing (incomplete LLVM)")
    endif()
endforeach()

set(CMAKE_C_COMPILER "${NX_CLANG_CL}")
set(CMAKE_CXX_COMPILER "${NX_CLANG_CL}")
# No CMAKE_<LANG>_COMPILER_TARGET: clang-cl already targets x86_64-pc-windows-msvc on an x86_64 host, and the --target
# CMake would add also reaches the LDFLAGS of the ports that do not use CMake; lld-link ignores it with a warning and
# the ffmpeg configure treats that warning as a failure ("C compiler test failed").
set(CMAKE_LINKER "${_nx_bin}/lld-link" CACHE FILEPATH "")
# CMAKE_AR: llvm-lib (lib.exe style, what CMake expects with clang-cl). Exception: with NX_AR_GNU (only the ffmpeg
# triplet) llvm-ar. ffmpeg does not use CMake to build; its compat/windows/makedef does "$AR rcs tmp.lib objs" to
# get the symbols for the .def, and with llvm-lib that fails ("rcs: no such file"). On Windows vcpkg wraps it in ar-lib.
if(NX_AR_GNU)
    set(CMAKE_AR "${_nx_bin}/llvm-ar" CACHE FILEPATH "")
else()
    set(CMAKE_AR "${_nx_bin}/llvm-lib" CACHE FILEPATH "")
endif()
set(CMAKE_RC_COMPILER "${_nx_bin}/llvm-rc" CACHE FILEPATH "")
set(CMAKE_MT "${_nx_bin}/llvm-mt" CACHE FILEPATH "")

# SDK version (a single folder in the xwin output) for the llvm-rc include paths.
file(GLOB _nx_sdk LIST_DIRECTORIES true "${NX_XWIN}/Windows Kits/10/Include/10.*")
list(LENGTH _nx_sdk _nx_n)
if(NOT _nx_n EQUAL 1)
    message(FATAL_ERROR "clangcl-xwin.cmake: 1 SDK version was expected in ${NX_XWIN}/Windows Kits/10/Include and there are ${_nx_n}")
endif()

# /winsysroot makes clang-cl and lld-link find the CRT, the STL and the SDK by themselves (same as INCLUDE/LIB of VS).
# MSVC version emulated by clang-cl (_MSC_VER): on Windows it takes it from the cl.exe of the VS environment; here from
# the xwin CRT (folder 14.51 -> 19.51). Without this clang-cl uses 19.33 and the VS 2026 STL sees a different compiler than on Windows.
file(GLOB _nx_crt RELATIVE "${NX_XWIN}/VC/Tools/MSVC" LIST_DIRECTORIES true "${NX_XWIN}/VC/Tools/MSVC/14.*")
list(LENGTH _nx_crt _nx_n)
if(NOT _nx_n EQUAL 1)
    message(FATAL_ERROR "clangcl-xwin.cmake: 1 CRT version was expected in ${NX_XWIN}/VC/Tools/MSVC and there are ${_nx_n}")
endif()
string(REGEX REPLACE "^14\\.([0-9]+).*" "19.\\1" NX_MSVC_COMPAT "${_nx_crt}")
set(NX_XWIN_CFLAGS "/winsysroot \"${NX_XWIN}\" -fms-compatibility-version=${NX_MSVC_COMPAT}")
# Case in the #includes (Linux is case sensitive, Windows is not): clang overlay generated by tools/linux/xwin_vfs.py.
if(EXISTS "${NX_XWIN}-vfs.yaml")
    string(APPEND NX_XWIN_CFLAGS " -vfsoverlay \"${NX_XWIN}-vfs.yaml\"")
endif()
set(NX_XWIN_LDFLAGS "/winsysroot:\"${NX_XWIN}\"")
set(NX_XWIN_RCFLAGS "")
# .rc: llvm-rc does not know -vfsoverlay; xwin_vfs.py leaves in <xwin>-rc/ links with the name variants (Winver.h...).
if(IS_DIRECTORY "${NX_XWIN}-rc")
    string(APPEND NX_XWIN_RCFLAGS " /I \"${NX_XWIN}-rc\"")
endif()
foreach(_nx_inc um shared ucrt winrt)
    string(APPEND NX_XWIN_RCFLAGS " /I \"${_nx_sdk}/${_nx_inc}\"")
endforeach()
file(GLOB _nx_vc LIST_DIRECTORIES true "${NX_XWIN}/VC/Tools/MSVC/*")
foreach(_nx_d ${_nx_vc})
    string(APPEND NX_XWIN_RCFLAGS " /I \"${_nx_d}/include\"")
endforeach()

# Game build: the flags are initialized (CMake adds its own per configuration).
set(CMAKE_C_FLAGS_INIT "${NX_XWIN_CFLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${NX_XWIN_CFLAGS}")
set(CMAKE_RC_FLAGS_INIT "${NX_XWIN_RCFLAGS}")
foreach(_nx_k EXE SHARED MODULE)
    set(CMAKE_${_nx_k}_LINKER_FLAGS_INIT "${NX_XWIN_LDFLAGS}")
endforeach()
# vcpkg: windows.cmake (included before) already left CMAKE_C_FLAGS etc. in the cache, so the _INIT ones do not count.
# For C, C++ and the linker the /winsysroot goes in the triplet (VCPKG_C_FLAGS, VCPKG_CXX_FLAGS, VCPKG_LINKER_FLAGS): it
# is what vcpkg_cmake_get_vars passes to the ports that do not use CMake (ffmpeg). Here only the llvm-rc include is missing.
# Also /c65001 is removed (rc.exe codepage set by windows.cmake): with llvm-rc, CMake preprocesses the .rc with clang-cl
# passing it the same flags (cmake_llvm_rc), and clang-cl on Linux takes "/c65001" for a file ("no such file").
# Without it, llvm-rc reads the .rc as ASCII: the .rc files of the ports and of the game have no text outside ASCII.
if(DEFINED _VCPKG_WINDOWS_TOOLCHAIN AND NOT "${CMAKE_RC_FLAGS}" MATCHES "Windows Kits")
    string(REPLACE "/c65001" "" _nx_rc "${CMAKE_RC_FLAGS}")
    set(CMAKE_RC_FLAGS "${_nx_rc} ${NX_XWIN_RCFLAGS}")
endif()
