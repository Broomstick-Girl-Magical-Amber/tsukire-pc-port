<resources>
    <!-- The game: full screen, drawing under the camera cutout so it gets the whole panel. -->
    <style name="Fullscreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
