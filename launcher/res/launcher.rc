// tsukihime.rc - recursos del exe: icono (el 1 lo usa la ventana con NX_WINDOW_ICON, apply_game_window.py) y
// la informacion de version que muestran el Explorador y el Administrador de tareas.
#include <winver.h>

1 ICON "tsukihime.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Tsukihime -A piece of blue glass moon-"
            VALUE "ProductName", "Tsukihime -A piece of blue glass moon- (PC recomp)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "OriginalFilename", "tsukihime.exe"
            VALUE "InternalName", "tsukihime"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
